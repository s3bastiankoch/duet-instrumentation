# Example Terraform variables for GCP Duet Benchmark Infrastructure
# Copy this file to terraform.tfvars and customize the values

# REQUIRED: Your GCP project ID
project_id = "your-gcp-project-id"

# Location
region = "europe-west3"
zone   = "europe-west3-a"

# Project configuration
project_name = "duet-benchmark"
owner_name   = "your-name"

# VM configuration
vm_machine_type         = "e2-standard-4"
loadgen_vm_machine_type = "e2-standard-2"
vm_disk_size_gb         = 100

# Ubuntu image family
image_project = "ubuntu-os-cloud"
image_family  = "ubuntu-2404-lts-amd64"

# Networking
network_cidr = "10.10.0.0/24"

# SSH access - update with your SSH key path
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# Network security - IMPORTANT: Consider restricting these in production
ssh_allowed_cidr       = "0.0.0.0/0"
http_allowed_cidr      = "0.0.0.0/0"
sut_ports_allowed_cidr = "0.0.0.0/0"

# Optional: Additional labels for resources
additional_labels = {
  environment = "development"
  owner       = "your-name"
  purpose     = "benchmark-testing"
}

